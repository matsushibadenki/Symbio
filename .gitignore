# Rust build output (including nested crates and development app bundles)
target/

# Generated Tauri schemas
/apps/desktop/gen/

# Frontend dependencies and build output; ui/ contains authored source
node_modules/
/dist/
/apps/*/dist/

# Local research documents and their process locks
*.symbio
*.symbio.lock
!/examples/**/*.symbio

# Local environment settings; keep shareable templates
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Logs, temporary files and editor recovery files
*.log
*.tmp
*.swp
*.swo
*~
.idea/

# macOS and Windows metadata
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Desktop.ini

# Cargo.lock is intentionally tracked for reproducible application builds.
